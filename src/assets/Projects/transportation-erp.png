<!-- Multi-Modal Transportation ERP Gateway -->
<svg width="800" height="600" viewBox="0 0 800 600" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="logistics1" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#4facfe;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#00f2fe;stop-opacity:1" />
    </linearGradient>
    <linearGradient id="logistics2" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#fa709a;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#fee140;stop-opacity:1" />
    </linearGradient>
    <linearGradient id="logistics3" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#a8edea;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#fed6e3;stop-opacity:1" />
    </linearGradient>
  </defs>
  
  <!-- Background -->
  <rect width="800" height="600" fill="#0f172a"/>
  
  <!-- Title -->
  <text x="400" y="35" text-anchor="middle" font-family="Arial, sans-serif" font-size="22" font-weight="bold" fill="white">
    Multi-Modal Transportation ERP Gateway
  </text>
  <text x="400" y="55" text-anchor="middle" font-family="Arial, sans-serif" font-size="14" fill="#64748b">
    150+ Locations • $50M+ Annual Transactions • Real-time Tracking
  </text>
  
  <!-- Transportation Modes -->
  <rect x="80" y="80" width="180" height="90" rx="10" fill="url(#logistics1)" opacity="0.9"/>
  <text x="170" y="105" text-anchor="middle" font-family="Arial, sans-serif" font-size="14" font-weight="bold" fill="white">
    🚛 Surface Transport
  </text>
  <text x="170" y="125" text-anchor="middle" font-family="Arial, sans-serif" font-size="11" fill="white">
    Road & Rail Networks</text>
  <text x="170" y="140" text-anchor="middle" font-family="Arial, sans-serif" font-size="11" fill="white">
    Domestic Logistics</text>
  <text x="170" y="155" text-anchor="middle" font-family="Arial, sans-serif" font-size="11" fill="white">
    Fleet Management</text>
  
  <rect x="310" y="80" width="180" height="90" rx="10" fill="url(#logistics2)" opacity="0.9"/>
  <text x="400" y="105" text-anchor="middle" font-family="Arial, sans-serif" font-size="14" font-weight="bold" fill="white">
    ✈️ Air Transport
  </text>
  <text x="400" y="125" text-anchor="middle" font-family="Arial, sans-serif" font-size="11" fill="white">
    Express Delivery</text>
  <text x="400" y="140" text-anchor="middle" font-family="Arial, sans-serif" font-size="11" fill="white">
    Time-Critical Cargo</text>
  <text x="400" y="155" text-anchor="middle" font-family="Arial, sans-serif" font-size="11" fill="white">
    Airport Coordination</text>
  
  <rect x="540" y="80" width="180" height="90" rx="10" fill="url(#logistics3)" opacity="0.9"/>
  <text x="630" y="105" text-anchor="middle" font-family="Arial, sans-serif" font-size="14" font-weight="bold" fill="#1e293b">
    🚢 International
  </text>
  <text x="630" y="125" text-anchor="middle" font-family="Arial, sans-serif" font-size="11" fill="#1e293b">
    Sea & Port Operations</text>
  <text x="630" y="140" text-anchor="middle" font-family="Arial, sans-serif" font-size="11" fill="#1e293b">
    Customs Clearance</text>
  <text x="630" y="155" text-anchor="middle" font-family="Arial, sans-serif" font-size="11" fill="#1e293b">
    Global Supply Chain</text>
  
  <!-- ERP Core -->
  <rect x="250" y="220" width="300" height="80" rx="12" fill="#1e40af" stroke="#3b82f6" stroke-width="2"/>
  <text x="400" y="245" text-anchor="middle" font-family="Arial, sans-serif" font-size="16" font-weight="bold" fill="white">
    ERP Gateway Core - .NET Core 6.0
  </text>
  <text x="400" y="265" text-anchor="middle" font-family="Arial, sans-serif" font-size="12" fill="#93c5fd">
    Order Management • Route Optimization • Financial Reconciliation
  </text>
  <text x="400" y="280" text-anchor="middle" font-family="Arial, sans-serif" font-size="12" fill="#93c5fd">
    Real-time Tracking • Automated Billing • Performance Analytics
  </text>
  
  <!-- API Services Layer -->
  <rect x="50" y="340" width="160" height="120" rx="8" fill="#374151" stroke="#10b981" stroke-width="2"/>
  <text x="130" y="365" text-anchor="middle" font-family="Arial, sans-serif" font-size="12" font-weight="bold" fill="white">
    Order Management
  </text>
  <text x="130" y="385" text-anchor="middle" font-family="Arial, sans-serif" font-size="10" fill="#d1fae5">
    25+ RESTful APIs</text>
  <text x="130" y="400" text-anchor="middle" font-family="Arial, sans-serif" font-size="10" fill="#6b7280">
    Booking & Scheduling</text>
  <text x="130" y="415" text-anchor="middle" font-family="Arial, sans-serif" font-size="10" fill="#6b7280">
    Status Updates</text>
  <text x="130" y="430" text-anchor="middle" font-family="Arial, sans-serif" font-size="10" fill="#6b7280">
    Exception Handling</text>
  <text x="130" y="445" text-anchor="middle" font-family="Arial, sans-serif" font-size="10" fill="#10b981">
    2000+ Concurrent Users</text>
  
  <rect x="240" y="340" width="160" height="120" rx="8" fill="#374151" stroke="#f59e0b" stroke-width="2"/>
  <text x="320" y="365" text-anchor="middle" font-family="Arial, sans-serif" font-size="12" font-weight="bold" fill="white">
    Route Optimization
  </text>
  <text x="320" y="385" text-anchor="middle" font-family="Arial, sans-serif" font-size="10" fill="#fed7aa">
    AI-Powered Routing</text>
  <text x="320" y="400" text-anchor="middle" font-family="Arial, sans-serif" font-size="10" fill="#6b7280">
    Traffic Analysis</text>
  <text x="320" y="415" text-anchor="middle" font-family="Arial, sans-serif" font-size="10" fill="#6b7280">
    Cost Optimization</text>
  <text x="320" y="430" text-anchor="middle" font-family="Arial, sans-serif" font-size="10" fill="#6b7280">
    Delivery Time Prediction</text>
  <text x="320" y="445" text-anchor="middle" font-family="Arial, sans-serif" font-size="10" fill="#f59e0b">
    60% Performance Boost</text>
  
  <rect x="430" y="340" width="160" height="120" rx="8" fill="#374151" stroke="#8b5cf6" stroke-width="2"/>
  <text x="510" y="365" text-anchor="middle" font-family="Arial, sans-serif" font-size="12" font-weight="bold" fill="white">
    Fleet Tracking
  </text>
  <text x="510" y="385" text-anchor="middle" font-family="Arial, sans-serif" font-size="10" fill="#ddd6fe">
    Real-time GPS</text>
  <text x="510" y="400" text-anchor="middle" font-family="Arial, sans-serif" font-size="10" fill="#6b7280">
    Vehicle Monitoring</text>
  <text x="510" y="415" text-anchor="middle" font-family="Arial, sans-serif" font-size="10" fill="#6b7280">
    Driver Management</text>
  <text x="510" y="430" text-anchor="middle" font-family="Arial, sans-serif" font-size="10" fill="#6b7280">
    Maintenance Alerts</text>
  <text x="510" y="445" text-anchor="middle" font-family="Arial, sans-serif" font-size="10" fill="#8b5cf6">
    24/7 Monitoring</text>
  
  <rect x="620" y="340" width="160" height="120" rx="8" fill="#374151" stroke="#ef4444" stroke-width="2"/>
  <text x="700" y="365" text-anchor="middle" font-family="Arial, sans-serif" font-size="12" font-weight="bold" fill="white">
    Financial Module
  </text>
  <text x="700" y="385" text-anchor="middle" font-family="Arial, sans-serif" font-size="10" fill="#fecaca">
    Automated Billing</text>
  <text x="700" y="400" text-anchor="middle" font-family="Arial, sans-serif" font-size="10" fill="#6b7280">
    Invoice Generation</text>
  <text x="700" y="415" text-anchor="middle" font-family="Arial, sans-serif" font-size="10" fill="#6b7280">
    Payment Processing</text>
  <text x="700" y="430" text-anchor="middle" font-family="Arial, sans-serif" font-size="10" fill="#6b7280">
    Financial Reports</text>
  <text x="700" y="445" text-anchor="middle" font-family="Arial, sans-serif" font-size="10" fill="#ef4444">
    $50M+ Transactions</text>
  
  <!-- Database & Security Layer -->
  <rect x="150" y="500" width="200" height="80" rx="8" fill="#1f2937" stroke="#06b6d4" stroke-width="2"/>
  <text x="250" y="525" text-anchor="middle" font-family="Arial, sans-serif" font-size="12" font-weight="bold" fill="white">
    Database Layer
  </text>
  <text x="250" y="545" text-anchor="middle" font-family="Arial, sans-serif" font-size="10" fill="#67e8f9">
    SQL Server • Oracle 19c</text>
  <text x="250" y="560" text-anchor="middle" font-family="Arial, sans-serif" font-size="10" fill="#6b7280">
    Data Warehousing • Replication</text>
  <text x="250" y="575" text-anchor="middle" font-family="Arial, sans-serif" font-size="10" fill="#06b6d4">
    3min Report Generation</text>
  
  <rect x="450" y="500" width="200" height="80" rx="8" fill="#1f2937" stroke="#22c55e" stroke-width="2"/>
  <text x="550" y="525" text-anchor="middle" font-family="Arial, sans-serif" font-size="12" font-weight="bold" fill="white">
    Security & Auth
  </text>
  <text x="550" y="545" text-anchor="middle" font-family="Arial, sans-serif" font-size="10" fill="#86efac">
    JWT Authentication • RBAC</text>
  <text x="550" y="560" text-anchor="middle" font-family="Arial, sans-serif" font-size="10" fill="#6b7280">
    SOC 2 Compliance</text>
  <text x="550" y="575" text-anchor="middle" font-family="Arial, sans-serif" font-size="10" fill="#22c55e">
    95% Security Incident Reduction</text>
  
  <!-- Connecting Lines -->
  <path d="M170 170 L320 210" stroke="#64748b" stroke-width="2" opacity="0.7"/>
  <path d="M400 170 L400 210" stroke="#64748b" stroke-width="2" opacity="0.7"/>
  <path d="M630 170 L480 210" stroke="#64748b" stroke-width="2" opacity="0.7"/>
  
  <path d="M320 300 L130 330" stroke="#64748b" stroke-width="2" opacity="0.7"/>
  <path d="M380 300 L320 330" stroke="#64748b" stroke-width="2" opacity="0.7"/>
  <path d="M420 300 L510 330" stroke="#64748b" stroke-width="2" opacity="0.7"/>
  <path d="M480 300 L700 330" stroke="#64748b" stroke-width="2" opacity="0.7"/>
  
  <path d="M250 460 L250 490" stroke="#64748b" stroke-width="2" opacity="0.7"/>
  <path d="M550 460 L550 490" stroke="#64748b" stroke-width="2" opacity="0.7"/>
</svg>